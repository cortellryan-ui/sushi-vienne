# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (emails transactionnels) ---
RESEND_API_KEY=
RESTAURANT_EMAIL=            # destinataire des commandes & du formulaire de contact
RESEND_FROM=                 # optionnel : expediteur (ex. "Sushi Smile <commandes@domaine.fr>"), sinon onboarding@resend.dev

# --- Stripe (paiement en ligne) ---
STRIPE_SECRET_KEY=           # sk_test_... (ou sk_live_... en production)
STRIPE_WEBHOOK_SECRET=       # whsec_... fourni par le dashboard Stripe / le CLI

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # en prod : URL publique (Vercel / domaine), PAS localhost
PREP_DELAY_MINUTES=20
